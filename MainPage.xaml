<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#004E56"
    BackgroundImageSource="lehp_texture.png"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid
            Padding="28,42,28,24"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

            <!-- Topo: menu + logos -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,0,0,18">

                <Border
                    WidthRequest="46"
                    HeightRequest="46"
                    Stroke="White"
                    StrokeThickness="3"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 23">
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="5">
                        <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="White" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="14"
                    VerticalOptions="Start">
                    <Image Source="logo_ufrpe.png" WidthRequest="40" HeightRequest="48" Aspect="AspectFit" />
                    <Image Source="logo_lehp.png" WidthRequest="70" HeightRequest="48" Aspect="AspectFit" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Logo principal -->
            <Image
                Grid.Row="1"
                Source="logo_coaxar.png"
                WidthRequest="150"
                HeightRequest="150"
                HorizontalOptions="Center"
                Margin="0,0,0,30"
                Aspect="AspectFit" />

            <!-- Banner com navegação para famílias -->
            <Border
                Grid.Row="2"
                HeightRequest="340"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 34"
                Margin="0,0,0,46">

                <Grid>
                    <Image Source="banner_anfibio.png" Aspect="AspectFill" />

                    <BoxView
                        VerticalOptions="End"
                        HeightRequest="130"
                        Opacity="0.65"
                        Color="Black" />

                    <Label
                        Text="Boana albomarginata (Spix, 1824)"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold,Italic"
                        Margin="22,24,0,0"
                        VerticalOptions="Start" />

                    <Label
                        Text="Conheça o canto dos Anfíbios Anuros do Estado de Pernambuco"
                        TextColor="White"
                        FontSize="19"
                        FontAttributes="Bold"
                        Margin="22,0,22,34"
                        VerticalOptions="End"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Spacing="14"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,14">
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="White" />
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="White" />
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="White" />
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="White" />
                    </HorizontalStackLayout>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBannerTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Botão: Famílias (Propostas Psicopedagógicas) -->
            <Border
                Grid.Row="3"
                HeightRequest="78"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                Margin="0,0,0,18">
                <Label
                    Text="Propostas Psicopedagógicas"
                    Style="{StaticResource CoaxarButtonText}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFamiliasTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Botão: IA (Em breve) -->
            <Border
                Grid.Row="4"
                HeightRequest="78"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                Margin="0,0,0,18">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="0">
                    <Label
                        Text="Identificação de Cantos por IA"
                        Style="{StaticResource CoaxarButtonText}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Em breve"
                        TextColor="#A95B5B"
                        FontFamily="RussoOne"
                        FontSize="20"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Botão: Guia de Uso -->
            <Border
                Grid.Row="5"
                HeightRequest="78"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                Margin="0,0,0,40">
                <Label
                    Text="Guia de Uso"
                    Style="{StaticResource CoaxarButtonText}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Rodapé -->
            <Label
                Grid.Row="6"
                Text="Sonoteca Coaxar do Laboratório de Estudos Herpetológicos e Paleoherpetológicos da Universidade Federal Rural de Pernambuco"
                TextColor="White"
                FontSize="11"
                HorizontalTextAlignment="Center"
                VerticalOptions="End" />

        </Grid>
    </ScrollView>
</ContentPage>

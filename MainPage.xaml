<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#004E56"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image
            Source="lehp_texture.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>
        <Grid
            Padding="{StaticResource CoaxarScreenPadding}"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

            <!-- Topo: menu + logos -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*,Auto"
                Margin="0,0,0,15">

                <Border
                    WidthRequest="{StaticResource CoaxarMenuSize}"
                    HeightRequest="{StaticResource CoaxarMenuSize}"
                    Stroke="White"
                    StrokeThickness="2.5"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 19">
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="{StaticResource CoaxarMenuLineSpacing}">
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="{StaticResource CoaxarTopSpacing}"
                    VerticalOptions="Start">
                    <Image Source="logo_ufrpe.png" WidthRequest="{StaticResource CoaxarTopLogoUfrpeWidth}" HeightRequest="{StaticResource CoaxarTopLogoHeight}" Aspect="AspectFit" />
                    <Image Source="logo_lehp.png" WidthRequest="{StaticResource CoaxarTopLogoLehpWidth}" HeightRequest="{StaticResource CoaxarTopLogoHeight}" Aspect="AspectFit" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Logo principal -->
            <Image
                Grid.Row="1"
                Source="logo_coaxar.png"
                WidthRequest="{StaticResource CoaxarMainLogoSize}"
                HeightRequest="{StaticResource CoaxarMainLogoSize}"
                HorizontalOptions="Center"
                Margin="{StaticResource CoaxarHomeLogoMargin}"
                Aspect="AspectFit" />

            <!-- Banner com navegação para famílias -->
            <Border
                Grid.Row="2"
                HeightRequest="{StaticResource CoaxarHomeBannerHeight}"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                StrokeShape="RoundRectangle 28"
                Margin="{StaticResource CoaxarHomeBannerMargin}">

                <Grid>
                    <Image Source="banner_anfibio.png" Aspect="AspectFill" />

                    <BoxView
                        VerticalOptions="End"
                        HeightRequest="{StaticResource CoaxarHomeBannerOverlayHeight}"
                        Opacity="0.65"
                        Color="Black" />

                    <Label
                        Text="Boana albomarginata (Spix, 1824)"
                        TextColor="White"
                        FontSize="{StaticResource CoaxarFontBodyLarge}"
                        FontAttributes="Bold,Italic"
                        Margin="{StaticResource CoaxarBannerSpeciesMargin}"
                        VerticalOptions="Start" />

                    <Label
                        Text="Conheça o canto dos Anfíbios Anuros do Estado de Pernambuco"
                        TextColor="White"
                        FontSize="{StaticResource CoaxarFontButton}"
                        FontAttributes="Bold"
                        Margin="{StaticResource CoaxarBannerTitleMargin}"
                        VerticalOptions="End"
                        HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Spacing="{StaticResource CoaxarTopSpacing}"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="{StaticResource CoaxarBannerDotsMargin}">
                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="White" />
                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="White" />
                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="White" />
                        <Ellipse WidthRequest="5" HeightRequest="5" Fill="White" />
                    </HorizontalStackLayout>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBannerTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Botão: Famílias (Propostas Psicopedagógicas) -->
            <Border
                Grid.Row="3"
                HeightRequest="{StaticResource CoaxarHomeButtonHeight}"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 23"
                Margin="{StaticResource CoaxarHomeButtonMargin}">
                <Label
                    Text="Propostas Psicopedagógicas"
                    Style="{StaticResource CoaxarButtonText}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFamiliasTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Botão: IA (Em breve) -->
            <Border
                Grid.Row="4"
                HeightRequest="{StaticResource CoaxarHomeButtonHeight}"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 23"
                Margin="{StaticResource CoaxarHomeButtonMargin}">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="0">
                    <Label
                        Text="Identificação de Cantos por IA"
                        Style="{StaticResource CoaxarButtonText}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="Em breve"
                        TextColor="#A95B5B"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontButton}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Botão: Guia de Uso -->
            <Border
                Grid.Row="5"
                HeightRequest="{StaticResource CoaxarHomeButtonHeight}"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 23"
                Margin="{StaticResource CoaxarHomeButtonLastMargin}">
                <Label
                    Text="Guia de Uso"
                    Style="{StaticResource CoaxarButtonText}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGuiaDeUsoTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Rodapé -->
            <Label
                Grid.Row="6"
                Text="Sonoteca Coaxar do Laboratório de Estudos Herpetológicos e Paleoherpetológicos da Universidade Federal Rural de Pernambuco"
                TextColor="White"
                FontSize="{StaticResource CoaxarFontCaption}"
                HorizontalTextAlignment="Center"
                VerticalOptions="End" />

        </Grid>
        </ScrollView>
    </Grid>
</ContentPage>

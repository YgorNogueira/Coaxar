<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#004E56"
    BackgroundImageSource="lehp_texture.png"
    Loaded="HomeLoaded">


    <Image
        x:Name="HomeImage"
        Aspect="AspectFit"
        HeightRequest="{StaticResource CoaxarMainLogoSize}"
        HorizontalOptions="Center"
        Opacity="0"
        Source="logo_coaxar.png"
        VerticalOptions="Center"
        WidthRequest="{StaticResource CoaxarMainLogoSize}" />

</ContentPage>

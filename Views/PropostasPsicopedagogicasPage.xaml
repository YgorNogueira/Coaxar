<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.Views.PropostasPsicopedagogicasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoaxarApp.Models"
    BackgroundColor="#004E56"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image
            Source="lehp_texture.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <CollectionView
            x:Name="PropostasCollection"
            Margin="{StaticResource CoaxarListMargin}">

            <CollectionView.Header>
                <VerticalStackLayout Padding="{StaticResource CoaxarListHeaderPadding}" Spacing="0">
                    <Image
                        Source="logo_coaxar.png"
                        WidthRequest="{StaticResource CoaxarListLogoSize}"
                        HeightRequest="{StaticResource CoaxarListLogoSize}"
                        HorizontalOptions="Center"
                        Aspect="AspectFit" />

                    <Border
                        HeightRequest="{StaticResource CoaxarTitleCardHeight}"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 23"
                        Margin="0,10,0,21">
                        <Label
                            Text="Propostas Psicopedagógicas"
                            Style="{StaticResource CoaxarButtonText}"
                            FontSize="{StaticResource CoaxarFontTitle}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Margin="0,0,0,26"
                        TextColor="White"
                        FontSize="{StaticResource CoaxarFontBodyLarge}"
                        LineHeight="1.3"
                        Text="Selecione uma proposta para acessar objetivos, habilidades BNCC, recursos, etapas de aplicação e critérios de avaliação." />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Vertical"
                    ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PropostaPsicopedagogicaModel">
                    <Border
                        Padding="18,16"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 23">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProposalTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="11">
                            <Label
                                Text="{Binding Nivel}"
                                TextColor="#004E56"
                                FontFamily="RussoOne"
                                FontSize="{StaticResource CoaxarFontTitle}" />

                            <Label
                                Text="{Binding Resumo}"
                                TextColor="#001D22"
                                FontSize="{StaticResource CoaxarFontBodyLarge}"
                                LineHeight="1.3" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                                <Border
                                    Padding="10,7"
                                    StrokeThickness="0"
                                    BackgroundColor="#004E56"
                                    StrokeShape="RoundRectangle 15">
                                    <Label
                                        Text="{Binding Duracao}"
                                        TextColor="White"
                                        FontSize="{StaticResource CoaxarFontBody}"
                                        HorizontalTextAlignment="Center" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,7"
                                    Stroke="#004E56"
                                    StrokeThickness="1.5"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 15">
                                    <Label
                                        Text="{Binding Area}"
                                        TextColor="#004E56"
                                        FontSize="{StaticResource CoaxarFontBody}"
                                        HorizontalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="{StaticResource CoaxarDetailSeparatorHeight}" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>

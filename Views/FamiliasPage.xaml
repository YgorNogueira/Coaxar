<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.Views.FamiliasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoaxarApp.Models"
    BackgroundColor="#004E56"
    BackgroundImageSource="lehp_texture.png"
    Shell.NavBarIsVisible="False">

    <CollectionView
        x:Name="FamiliasCollection"
        Margin="40,0"
        SelectionMode="Single"
        SelectionChanged="OnFamiliaSelected">

        <CollectionView.Header>
            <VerticalStackLayout Padding="0,14,0,0">

                <Image
                    Source="logo_coaxar.png"
                    WidthRequest="64"
                    HeightRequest="64"
                    HorizontalOptions="Center"
                    Aspect="AspectFit" />

                <!-- Busca pronta para receber resultados do repositório/SQLite -->
                <Border
                    HeightRequest="44"
                    Stroke="White"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 22"
                    Margin="0,16,0,0">

                    <Grid
                        Padding="14,0"
                        ColumnDefinitions="22,*"
                        ColumnSpacing="9">

                        <Path
                            Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 21,21"
                            Stroke="White"
                            StrokeThickness="2"
                            Fill="Transparent"
                            WidthRequest="22"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Entry
                            x:Name="BuscaEntry"
                            Grid.Column="1"
                            Placeholder="Encontre as espécies pelo nome"
                            PlaceholderColor="White"
                            TextColor="White"
                            FontSize="12"
                            MinimumHeightRequest="36"
                            VerticalOptions="Center"
                            TextChanged="OnBuscaTextChanged" />

                    </Grid>
                </Border>

                <Label
                    Text="Famílias"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Margin="0,14,0,12" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <GridItemsLayout
                Orientation="Vertical"
                Span="2"
                HorizontalItemSpacing="38"
                VerticalItemSpacing="14" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:FamiliaModel">
                <Border
                    HeightRequest="110"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 22">

                    <Grid>
                        <Image
                            Source="{Binding ImagemPath}"
                            Aspect="AspectFill"
                            HeightRequest="110"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                        <Label
                            Text="{Binding Nome}"
                            TextColor="White"
                            FontSize="10"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            VerticalOptions="End"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Margin="4,0,4,10">
                            <Label.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="1"
                                    Radius="3"
                                    Offset="1,1" />
                            </Label.Shadow>
                        </Label>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="40" Color="Transparent" />
        </CollectionView.Footer>

    </CollectionView>
</ContentPage>

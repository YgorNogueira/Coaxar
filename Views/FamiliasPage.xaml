<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.Views.FamiliasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoaxarApp.Models"
    BackgroundColor="#004E56"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image
            Source="lehp_texture.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <CollectionView
        x:Name="FamiliasCollection"
        Margin="{StaticResource CoaxarListMargin}"
        SelectionMode="Single"
        SelectionChanged="OnFamilySelected">

        <CollectionView.Header>
            <VerticalStackLayout Padding="{StaticResource CoaxarListHeaderPadding}">

                <Image
                    Source="logo_coaxar.png"
                    WidthRequest="{StaticResource CoaxarListLogoSize}"
                    HeightRequest="{StaticResource CoaxarListLogoSize}"
                    HorizontalOptions="Center"
                    Aspect="AspectFit" />

                <!-- Busca pronta para receber resultados do repositório/SQLite -->
                <Border
                    HeightRequest="{StaticResource CoaxarSearchHeight}"
                    Stroke="White"
                    StrokeThickness="2.5"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 22"
                    Margin="{StaticResource CoaxarSearchMargin}">

                    <Grid
                        Padding="{StaticResource CoaxarSearchGridPadding}"
                        ColumnDefinitions="22,*"
                        ColumnSpacing="{StaticResource CoaxarSearchColumnSpacing}">

                        <Path
                            Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 21,21"
                            Stroke="White"
                            StrokeThickness="2"
                            Fill="Transparent"
                            WidthRequest="{StaticResource CoaxarSearchIconSize}"
                            HeightRequest="{StaticResource CoaxarSearchIconSize}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Entry
                            x:Name="BuscaEntry"
                            Grid.Column="1"
                            Placeholder="Encontre as espécies pelo nome"
                            PlaceholderColor="White"
                            TextColor="White"
                            FontSize="{StaticResource CoaxarFontButton}"
                            MinimumHeightRequest="{StaticResource CoaxarSearchEntryMinHeight}"
                            VerticalOptions="Center"
                            TextChanged="OnSearchTextChanged" />

                    </Grid>
                </Border>

                <Label
                    Text="Famílias"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="{StaticResource CoaxarFontTitle}"
                    HorizontalOptions="Center"
                    Margin="{StaticResource CoaxarListTitleMargin}" />

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <GridItemsLayout
                Orientation="Vertical"
                Span="2"
                HorizontalItemSpacing="{StaticResource CoaxarListHorizontalSpacing}"
                VerticalItemSpacing="{StaticResource CoaxarListVerticalSpacing}" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:FamiliaModel">
                <Border
                    HeightRequest="{StaticResource CoaxarFamilyCardHeight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 23">

                    <Grid>
                        <Image
                            Source="{Binding ImagemPath}"
                            Aspect="AspectFill"
                            HeightRequest="{StaticResource CoaxarFamilyCardHeight}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
                        <Label
                            Text="{Binding Nome}"
                            TextColor="White"
                            FontSize="{StaticResource CoaxarFontBodyLarge}"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            VerticalOptions="End"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Margin="{StaticResource CoaxarCardTextMargin}">
                            <Label.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="1"
                                    Radius="3"
                                    Offset="1,1" />
                            </Label.Shadow>
                        </Label>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="{StaticResource CoaxarDetailSeparatorHeight}" Color="Transparent" />
        </CollectionView.Footer>

        </CollectionView>
    </Grid>
</ContentPage>

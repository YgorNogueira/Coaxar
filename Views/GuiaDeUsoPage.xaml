<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.Views.GuiaDeUsoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#004550"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image
            Source="lehp_texture.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Topo: menu + logos -->
            <Grid
                Padding="{StaticResource CoaxarHeaderPadding}"
                ColumnDefinitions="Auto,*,Auto">

                <Border
                    WidthRequest="{StaticResource CoaxarMenuSize}"
                    HeightRequest="{StaticResource CoaxarMenuSize}"
                    Stroke="White"
                    StrokeThickness="2.5"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 19">
                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="{StaticResource CoaxarMenuLineSpacing}">
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                        <BoxView WidthRequest="{StaticResource CoaxarMenuLineWidth}" HeightRequest="{StaticResource CoaxarMenuLineHeight}" CornerRadius="2" Color="White" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="{StaticResource CoaxarTopSpacing}"
                    VerticalOptions="Start">
                    <Image Source="logo_ufrpe.png" WidthRequest="{StaticResource CoaxarTopLogoUfrpeWidth}" HeightRequest="{StaticResource CoaxarTopLogoHeight}" Aspect="AspectFit" />
                    <Image Source="logo_lehp.png" WidthRequest="{StaticResource CoaxarTopLogoLehpWidth}" HeightRequest="{StaticResource CoaxarTopLogoHeight}" Aspect="AspectFit" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Logo principal -->
            <Image
                Source="logo_coaxar.png"
                WidthRequest="{StaticResource CoaxarMainLogoSize}"
                HeightRequest="{StaticResource CoaxarMainLogoSize}"
                HorizontalOptions="Center"
                Margin="{StaticResource CoaxarGuideLogoMargin}"
                Aspect="AspectFit" />

            <!-- Título -->
            <Border
                HeightRequest="{StaticResource CoaxarTitleCardHeight}"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 23"
                Margin="{StaticResource CoaxarGuideTitleMargin}">
                <Label
                    Text="Guia de Uso"
                    Style="{StaticResource CoaxarButtonText}"
                    FontSize="{StaticResource CoaxarFontTitle}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Texto introdutório -->
            <Label
                Margin="{StaticResource CoaxarParagraphMargin}"
                TextColor="White"
                FontSize="{StaticResource CoaxarFontBodyLarge}"
                LineHeight="1.3"
                Text="A Sonoteca Coaxar é uma plataforma de acesso público, disponível para toda a população. Por meio dela, estudantes, professores, pesquisadores e demais interessados podem conhecer os anfíbios anuros de Pernambuco, consultar informações sobre as espécies e ouvir suas vocalizações. A plataforma também pode ser utilizada como recurso de apoio em aulas, atividades de campo, ações de educação ambiental e outras práticas educativas. Descubra como explorar todas as suas funcionalidades abaixo." />

            <!-- ===================== Seção 1: Busca por nome ===================== -->

            <HorizontalStackLayout Margin="{StaticResource CoaxarSectionMargin}" Spacing="7">
                <Label Text="•" TextColor="White" FontSize="{StaticResource CoaxarFontButton}" FontAttributes="Bold" />
                <Label
                    Text="Encontre uma espécie pelo nome"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="{StaticResource CoaxarFontSection}"
                    FontAttributes="Bold" />
            </HorizontalStackLayout>

            <Label
                Margin="{StaticResource CoaxarInstructionMargin}"
                TextColor="White"
                FontSize="{StaticResource CoaxarFontBody}"
                Text="Digite o nome comum ou científico da espécie na barra de busca." />

            <!-- Passo 1 -->
            <Grid Margin="{StaticResource CoaxarGuideStepMargin}" ColumnDefinitions="33,*" ColumnSpacing="12">
                <Border
                    WidthRequest="{StaticResource CoaxarStepBadgeSize}"
                    HeightRequest="{StaticResource CoaxarStepBadgeSize}"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        Text="1"
                        TextColor="#004E56"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Column="1"
                    HeightRequest="{StaticResource CoaxarGuideSearchHeight}"
                    Stroke="White"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 18"
                    VerticalOptions="Center">
                    <Grid Padding="{StaticResource CoaxarSearchGridPadding}" ColumnDefinitions="18,*" ColumnSpacing="7">
                        <Path
                            Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 21,21"
                            Stroke="White"
                            StrokeThickness="2"
                            Fill="Transparent"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="Encontre as espécies pelo nome"
                            TextColor="White"
                            FontSize="{StaticResource CoaxarFontSmall}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Passo 2 -->
            <Grid Margin="{StaticResource CoaxarGuideStepMargin}" ColumnDefinitions="33,*" ColumnSpacing="12">
                <Border
                    WidthRequest="{StaticResource CoaxarStepBadgeSize}"
                    HeightRequest="{StaticResource CoaxarStepBadgeSize}"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        Text="2"
                        TextColor="#004E56"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <Border
                        HeightRequest="{StaticResource CoaxarGuideSearchHeight}"
                        Stroke="White"
                        StrokeThickness="2"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 18"
                        VerticalOptions="Center">
                        <Grid Padding="{StaticResource CoaxarSearchSmallGridPadding}" ColumnDefinitions="15,*" ColumnSpacing="{StaticResource CoaxarSearchSmallColumnSpacing}">
                            <Path
                                Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 21,21"
                                Stroke="White"
                                StrokeThickness="2"
                                Fill="Transparent"
                                WidthRequest="{StaticResource CoaxarSearchSmallIconSize}"
                                HeightRequest="{StaticResource CoaxarSearchSmallIconSize}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Rhinella dypticha"
                                FontAttributes="Italic"
                                TextColor="White"
                                FontSize="{StaticResource CoaxarFontCaption}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="ou"
                        TextColor="White"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        VerticalOptions="Center" />

                    <Border
                        Grid.Column="2"
                        HeightRequest="{StaticResource CoaxarGuideSearchHeight}"
                        Stroke="White"
                        StrokeThickness="2"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 18"
                        VerticalOptions="Center">
                        <Grid Padding="{StaticResource CoaxarSearchSmallGridPadding}" ColumnDefinitions="15,*" ColumnSpacing="{StaticResource CoaxarSearchSmallColumnSpacing}">
                            <Path
                                Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 21,21"
                                Stroke="White"
                                StrokeThickness="2"
                                Fill="Transparent"
                                WidthRequest="{StaticResource CoaxarSearchSmallIconSize}"
                                HeightRequest="{StaticResource CoaxarSearchSmallIconSize}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Cururu"
                                TextColor="White"
                                FontSize="{StaticResource CoaxarFontCaption}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Passo 3 -->
            <Grid Margin="{StaticResource CoaxarGuideStepTightMargin}" ColumnDefinitions="33,*" ColumnSpacing="12">
                <Border
                    WidthRequest="{StaticResource CoaxarStepBadgeSize}"
                    HeightRequest="{StaticResource CoaxarStepBadgeSize}"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Start">
                    <Label
                        Text="3"
                        TextColor="#004E56"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Column="1"
                    HeightRequest="{StaticResource CoaxarGuideSelectedCardHeight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">
                    <Image Source="rhinella_dypticha.png" Aspect="AspectFill" />
                </Border>
            </Grid>

            <Label Margin="0,8,0,28" FontSize="{StaticResource CoaxarFontBody}" HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Rhinella dypticha " TextColor="White" FontAttributes="Bold,Italic" />
                        <Span Text="(Cope, 1862)" TextColor="White" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- ===================== Seção 2: Busca por família ===================== -->

            <HorizontalStackLayout Margin="{StaticResource CoaxarSectionMargin}" Spacing="7">
                <Label Text="•" TextColor="White" FontSize="{StaticResource CoaxarFontButton}" FontAttributes="Bold" />
                <Label
                    Text="Encontre uma espécie navegando pelas famílias"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="{StaticResource CoaxarFontSection}"
                    FontAttributes="Bold" />
            </HorizontalStackLayout>

            <Label
                Margin="{StaticResource CoaxarInstructionMargin}"
                TextColor="White"
                FontSize="{StaticResource CoaxarFontBody}"
                Text="Explore as famílias disponíveis em ordem alfabética. Ao selecionar uma família, você poderá navegar pelos gêneros e espécies correspondentes." />

            <!-- Passo 1: Famílias -->
            <Grid Margin="{StaticResource CoaxarGuideStepTightMargin}" ColumnDefinitions="33,*" ColumnSpacing="12">
                <Border
                    WidthRequest="{StaticResource CoaxarStepBadgeSize}"
                    HeightRequest="{StaticResource CoaxarStepBadgeSize}"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        Text="1"
                        TextColor="#004E56"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Famílias"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="{StaticResource CoaxarFontSection}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <Grid Margin="{StaticResource CoaxarGuideCardGridMargin}" ColumnDefinitions="*,*" ColumnSpacing="13">
                <Border
                    Grid.Column="0"
                    HeightRequest="{StaticResource CoaxarGuideFamilyCardHeight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <Grid>
                        <Image Source="familia_aromobatidae.png" Aspect="AspectFill" />
                        <Label
                            Text="Arobomantidae"
                            TextColor="White"
                            FontSize="{StaticResource CoaxarFontTiny}"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            VerticalOptions="End"
                            HorizontalOptions="Center"
                            Margin="3,0,3,7">
                            <Label.Shadow>
                                <Shadow Brush="Black" Opacity="1" Radius="3" Offset="1,1" />
                            </Label.Shadow>
                        </Label>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    HeightRequest="{StaticResource CoaxarGuideFamilyCardHeight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16">
                    <Grid>
                        <Image Source="familia_bufonidae.png" Aspect="AspectFill" />
                        <Label
                            Text="Bufonidae"
                            TextColor="White"
                            FontSize="{StaticResource CoaxarFontTiny}"
                            FontFamily="OpenSansSemibold"
                            FontAttributes="Bold"
                            VerticalOptions="End"
                            HorizontalOptions="Center"
                            Margin="3,0,3,7">
                            <Label.Shadow>
                                <Shadow Brush="Black" Opacity="1" Radius="3" Offset="1,1" />
                            </Label.Shadow>
                        </Label>
                    </Grid>
                </Border>
            </Grid>

            <!-- Passo 2: Gêneros -->
            <Grid Margin="{StaticResource CoaxarGuideStepMargin}" ColumnDefinitions="33,*" ColumnSpacing="12">
                <Border
                    WidthRequest="{StaticResource CoaxarStepBadgeSize}"
                    HeightRequest="{StaticResource CoaxarStepBadgeSize}"
                    StrokeThickness="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        Text="2"
                        TextColor="#004E56"
                        FontFamily="RussoOne"
                        FontSize="{StaticResource CoaxarFontSection}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label Grid.Column="1" TextColor="White" FontFamily="OpenSansSemibold" FontSize="{StaticResource CoaxarFontBodyLarge}" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Gênero: " TextColor="White" />
                            <Span Text="Frostius" TextColor="White" FontAttributes="Bold,Italic" />
                            <Span Text=" (1 sp.)" TextColor="White" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <Grid Margin="{StaticResource CoaxarGuideInsetCardMargin}" ColumnDefinitions="*,*" ColumnSpacing="13">
                <Border
                    Grid.Column="0"
                    HeightRequest="{StaticResource CoaxarGuideSpeciesCardHeight}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15">
                    <Image Source="frostius_sp.png" Aspect="AspectFill" />
                </Border>
            </Grid>

            <Label
                Margin="{StaticResource CoaxarGuideInsetLabelMargin}"
                TextColor="White"
                FontSize="{StaticResource CoaxarFontCaption}"
                HorizontalTextAlignment="Start">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Frostius pernambucensis" TextColor="White" FontAttributes="Bold,Italic" />
                        <Span Text=" (Bokermann, 1962)" TextColor="White" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label
                Margin="23,0,23,12"
                TextColor="White"
                FontFamily="OpenSansSemibold"
                FontSize="{StaticResource CoaxarFontBodyLarge}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Gênero: " TextColor="White" />
                        <Span Text="Rhinella" TextColor="White" FontAttributes="Bold,Italic" />
                        <Span Text=" (4 spp.)" TextColor="White" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Grid Margin="23,0,23,8" ColumnDefinitions="*,*" ColumnSpacing="13" RowDefinitions="Auto,Auto" RowSpacing="7">
                <Border Grid.Row="0" Grid.Column="0" HeightRequest="{StaticResource CoaxarGuideSpeciesCardHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Image Source="rhinella_crucifer.png" Aspect="AspectFill" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" HeightRequest="{StaticResource CoaxarGuideSpeciesCardHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Image Source="rhinella_granulosa.png" Aspect="AspectFill" />
                </Border>
                <Border Grid.Row="1" Grid.Column="0" HeightRequest="{StaticResource CoaxarGuideSpeciesCardHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Image Source="rhinella_dypticha.png" Aspect="AspectFill" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" HeightRequest="{StaticResource CoaxarGuideSpeciesCardHeight}" StrokeThickness="0" StrokeShape="RoundRectangle 15">
                    <Image Source="rhinella_hoogmoedi.png" Aspect="AspectFill" />
                </Border>
            </Grid>

            <Grid Margin="23,3,23,26" ColumnDefinitions="*,*" ColumnSpacing="13">
                <Label Grid.Column="0" TextColor="White" FontSize="{StaticResource CoaxarFontTiny}" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Rhinella crucifer" TextColor="White" FontAttributes="Bold,Italic" />
                            <Span Text=" (Wied-Neuwied, 1821)" TextColor="White" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Grid.Column="1" TextColor="White" FontSize="{StaticResource CoaxarFontTiny}" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Rhinella granulosa" TextColor="White" FontAttributes="Bold,Italic" />
                            <Span Text=" (Spix, 1824)" TextColor="White" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <Grid Margin="{StaticResource CoaxarGuideBottomMargin}" ColumnDefinitions="*,*" ColumnSpacing="13">
                <Label Grid.Column="0" TextColor="White" FontSize="{StaticResource CoaxarFontTiny}" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Rhinella dypticha" TextColor="White" FontAttributes="Bold,Italic" />
                            <Span Text=" (Cope, 1862)" TextColor="White" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Grid.Column="1" TextColor="White" FontSize="{StaticResource CoaxarFontTiny}" HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Rhinella hoogmoedi " TextColor="White" FontAttributes="Bold,Italic" />
                            <Span Text="Caramaschi and Pombal, 2006" TextColor="White" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <!-- ===================== Seções 3 e 4: Conheça a espécie / Morfologia e cantos ===================== -->
            <!-- Reproduzidas como imagens fixas (guia3.png / guia4.png) para evitar problemas de layout em telas estreitas -->

            <Image Source="guia3.png" Aspect="AspectFit" HorizontalOptions="Fill" />
            <Image Source="guia4.png" Aspect="AspectFit" HorizontalOptions="Fill" />

            <BoxView HeightRequest="{StaticResource CoaxarDetailSeparatorHeight}" Color="#004E56" />

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

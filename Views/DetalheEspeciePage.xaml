<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoaxarApp.Views.DetalheEspeciePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CoaxarApp.Controls"
    BackgroundColor="#004E56"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image
            Source="lehp_texture.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InputTransparent="True" />

        <ScrollView>
        <VerticalStackLayout Spacing="0" BackgroundColor="Transparent">

            <!-- Imagem principal (toque abre o visualizador com zoom) -->
            <Grid HeightRequest="{StaticResource CoaxarDetailHeaderHeight}">
                <Image x:Name="HeaderImage" Aspect="AspectFill">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderImageTapped" />
                    </Image.GestureRecognizers>
                </Image>

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="7,3"
                    StrokeShape="RoundRectangle 3"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Margin="10,36,0,0">
                    <Label x:Name="FotoCreditoLabel" TextColor="#1B1B1B" FontSize="{StaticResource CoaxarFontSmall}" />
                </Border>

                <!-- Ícone indicando que a foto pode ser ampliada -->
                <!-- As coordenadas têm margem de 2px para o traço não ser cortado nas bordas -->
                <Border
                    BackgroundColor="#66000000"
                    StrokeThickness="0"
                    Padding="6"
                    StrokeShape="RoundRectangle 8"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,10,10"
                    InputTransparent="True">
                    <Path
                        Data="M 2,8 L 2,2 L 8,2 M 16,2 L 22,2 L 22,8 M 22,16 L 22,22 L 16,22 M 8,22 L 2,22 L 2,16"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeLineCap="Round"
                        Fill="Transparent"
                        WidthRequest="24"
                        HeightRequest="24" />
                </Border>
            </Grid>

            <!-- Cabeçalho: nome + mapa -->
            <Grid
                BackgroundColor="White"
                Padding="18,21,18,20"
                ColumnDefinitions="*,98"
                RowDefinitions="Auto,Auto">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontDetailTitle}"
                    FontAttributes="Bold">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span x:Name="NomeCientificoSpan" TextColor="#001D22" FontAttributes="Bold,Italic" />
                            <Span x:Name="AutorAnoSpan" TextColor="#001D22" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label
                    x:Name="NomeComumLabel"
                    Grid.Row="1"
                    Grid.Column="0"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontDetailSubtitle}"
                    Margin="0,3,0,0" />

                <Image
                    x:Name="MapaImage"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    WidthRequest="{StaticResource CoaxarMapWidth}"
                    HeightRequest="{StaticResource CoaxarMapHeight}"
                    Aspect="AspectFit"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Morfologia: tamanhos + descrição -->
            <Grid
                BackgroundColor="White"
                ColumnDefinitions="123,2,*"
                Padding="0">

                <Grid
                    Grid.Column="0"
                    Padding="12,16"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,*">

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Source="frog_male.png"
                        WidthRequest="{StaticResource CoaxarFrogIconSize}"
                        HeightRequest="{StaticResource CoaxarFrogIconSize}"
                        HorizontalOptions="Center" />

                    <Image
                        Grid.Row="0"
                        Grid.Column="1"
                        Source="frog_female.png"
                        WidthRequest="{StaticResource CoaxarFrogIconSize}"
                        HeightRequest="{StaticResource CoaxarFrogIconSize}"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="TamanhoMachoLabel"
                        Grid.Row="1"
                        Grid.Column="0"
                        TextColor="#001D22"
                        FontSize="{StaticResource CoaxarFontBody}"
                        HorizontalOptions="Center"
                        Margin="0,7,0,0" />

                    <Label
                        x:Name="TamanhoFemeaLabel"
                        Grid.Row="1"
                        Grid.Column="1"
                        TextColor="#001D22"
                        FontSize="{StaticResource CoaxarFontBody}"
                        HorizontalOptions="Center"
                        Margin="0,7,0,0" />
                </Grid>

                <BoxView Grid.Column="1" WidthRequest="2" Color="#004E56" />

                <Label
                    Grid.Column="2"
                    Padding="12,13,13,13"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontBody}"
                    LineHeight="1.35">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Morfologia: " TextColor="#001D22" FontAttributes="Bold" />
                            <Span x:Name="MorfologiaSpan" TextColor="#001D22" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <!-- Separador verde -->
            <BoxView HeightRequest="{StaticResource CoaxarDetailSeparatorHeight}" Color="#004E56" />

            <!-- Canto de anúncio -->
            <VerticalStackLayout
                BackgroundColor="White"
                Padding="23,21,23,23"
                Spacing="{StaticResource CoaxarFontButton}">

                <Label
                    Text="Canto de anúncio"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontDetailSection}"
                    FontFamily="RussoOne"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,107" ColumnSpacing="15">
                    <Image
                        x:Name="EspectrogramaImage"
                        Grid.Column="0"
                        HeightRequest="{StaticResource CoaxarSpectrogramHeight}"
                        Aspect="AspectFit" />

                    <Border
                        Grid.Column="1"
                        WidthRequest="{StaticResource CoaxarPlayButtonSize}"
                        HeightRequest="{StaticResource CoaxarPlayButtonSize}"
                        StrokeThickness="0"
                        BackgroundColor="#004E56"
                        StrokeShape="RoundRectangle 45"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Path
                            Fill="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Data="M 0 0 L 0 58 L 48 29 Z"
                            WidthRequest="{StaticResource CoaxarPlayIconWidth}"
                            HeightRequest="{StaticResource CoaxarPlayIconHeight}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlayAdvertisementCallTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Label
                    x:Name="SclehpLabel"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontTiny}"
                    FontAttributes="Bold"
                    HorizontalOptions="End" />

            </VerticalStackLayout>

            <!-- Canto de Soltura -->
            <Grid
                BackgroundColor="White"
                Padding="25,15"
                ColumnDefinitions="*,Auto"
                Margin="0,18,0,0">

                <Label
                    Text="Canto de Soltura"
                    TextColor="#001D22"
                    FontSize="{StaticResource CoaxarFontDetailSubsection}"
                    FontFamily="RussoOne"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="1"
                    WidthRequest="{StaticResource CoaxarSmallPlayButtonSize}"
                    HeightRequest="{StaticResource CoaxarSmallPlayButtonSize}"
                    StrokeThickness="0"
                    BackgroundColor="#004E56"
                    StrokeShape="RoundRectangle 20"
                    VerticalOptions="Center">
                    <Path
                        Fill="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Data="M 0 0 L 0 28 L 24 14 Z"
                        WidthRequest="{StaticResource CoaxarSmallPlayIconWidth}"
                        HeightRequest="{StaticResource CoaxarSmallPlayIconHeight}" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlayReleaseCallTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <BoxView HeightRequest="{StaticResource CoaxarDetailSeparatorHeight}" Color="#004E56" />

        </VerticalStackLayout>
        </ScrollView>

        <!-- Visualizador de imagem com zoom (pinça, arrastar e duplo toque) -->
        <Grid
            x:Name="ImageViewerOverlay"
            IsVisible="False"
            BackgroundColor="#F2001318">

            <controls:PinchZoomContainer x:Name="ZoomContainer">
                <Image
                    x:Name="ZoomImage"
                    Aspect="AspectFit"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </controls:PinchZoomContainer>

            <!-- Botão de fechar -->
            <!-- As coordenadas têm margem de 2px para o traço não ser cortado nas bordas -->
            <Border
                BackgroundColor="#66FFFFFF"
                StrokeThickness="0"
                Padding="10"
                StrokeShape="RoundRectangle 21"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,42,16,0">
                <Path
                    Data="M 2,2 L 16,16 M 16,2 L 2,16"
                    Stroke="White"
                    StrokeThickness="2.5"
                    StrokeLineCap="Round"
                    Fill="Transparent"
                    WidthRequest="18"
                    HeightRequest="18" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseImageViewerTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
